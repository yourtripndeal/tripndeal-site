{% extends "layout.njk" %}

{% block content %}
<section class="py-20 px-4 max-w-screen-md mx-auto">
  <h1 class="text-4xl font-bold text-indigo-700 mb-4">{{ title }}</h1>

  {% if description %}
    <p class="text-lg text-gray-600 mb-6">{{ description }}</p>
  {% endif %}

  {% if image %}
  <figure class="mb-8">
    <img 
  src="/images/maldives-optimized.jpg" 
  alt="Maldives Luxury Escape" 
  loading="lazy" 
  decoding="async"
  class="max-w-xl h-auto object-contain mx-auto rounded-lg shadow-md"
>
    <figcaption class="text-center text-sm text-gray-500 mt-2">{{ title }}</figcaption>
  </figure>
  {% endif %}

  <div class="prose prose-lg text-gray-800 mb-8">
    {{ content | safe }}
  </div>

  <p>
    <a href="/packages/" class="text-blue-600 hover:underline">← Back to all packages</a>
  </p>
</section>
{% endblock %}
