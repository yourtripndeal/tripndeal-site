{% extends "./layout.njk" %}

{% block content %}
<section class="py-20 px-4 max-w-screen-md mx-auto">
  <h1 class="text-4xl font-bold text-indigo-700 mb-4">{{ title }}</h1>
  <p class="text-lg text-gray-600 mb-6">{{ description }}</p>

  {% if image %}
<section class="w-full px-4 py-8">
  <div class="max-w-screen-md mx-auto">
    <figure class="w-full">
      <div class="w-full max-w-xl mx-auto">
        <img 
          src="{{ image }}" 
          alt="{{ title }}" 
          loading="lazy" 
          decoding="async"
          class="w-full h-auto object-contain rounded-lg shadow-md"
        >
      </div>
      <figcaption class="text-center text-sm text-gray-500 mt-2">{{ title }}</figcaption>
    </figure>
  </div>
</section>
{% endif %}

  <div class="prose prose-lg text-gray-800">
    {{ content | safe }}
  </div>
</section>
{% endblock %}