{% extends "./layout.njk" %}

{% block content %}
<section class="py-20 px-4 max-w-screen-md mx-auto">
  <h1 class="text-4xl font-bold text-indigo-700 mb-4">{{ title }}</h1>
  <p class="text-lg text-gray-600 mb-6">{{ description }}</p>

  {% if image %}
<section class="flex justify-center items-center px-4 py-8">
  <img 
    src="{{ image }}" 
    alt="{{ title }}" 
    loading="lazy" 
    decoding="async"
    class="object-scale-down max-w-full max-h-[80vh] rounded-lg shadow-md"
  >
</section>
{% endif %}

  <div class="prose prose-lg text-gray-800">
    {{ content | safe }}
  </div>
</section>
{% endblock %}